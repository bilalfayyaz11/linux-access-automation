<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>{{ server_name }} - {{ environment_name }}</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 40px;
            background: #f4f6f8;
        }
        .container {
            max-width: 950px;
            margin: auto;
            background: white;
            padding: 32px;
            border-radius: 14px;
            box-shadow: 0 0 14px rgba(0,0,0,0.12);
        }
        .badge {
            display: inline-block;
            padding: 8px 16px;
            background: #2563eb;
            color: white;
            border-radius: 999px;
            font-weight: bold;
        }
        .grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 18px;
            margin-top: 24px;
        }
        .card {
            background: #f9fafb;
            border-left: 5px solid #2563eb;
            padding: 18px;
            border-radius: 8px;
        }
        .success {
            margin-top: 28px;
            padding: 18px;
            background: #dcfce7;
            color: #166534;
            border-radius: 8px;
            font-weight: bold;
        }
    </style>
</head>
<body>
<div class="container">
    <h1>Environment-Aware Web Deployment</h1>
    <h2>{{ server_name }}</h2>
    <span class="badge">{{ environment_name }}</span>

    <div class="grid">
        <div class="card">
            <h3>Server</h3>
            <p><strong>Inventory Host:</strong> {{ inventory_hostname }}</p>
            <p><strong>OS:</strong> {{ ansible_distribution }} {{ ansible_distribution_version }}</p>
            <p><strong>Architecture:</strong> {{ ansible_architecture }}</p>
            <p><strong>Application Version:</strong> {{ app_version }}</p>
        </div>

        <div class="card">
            <h3>Runtime</h3>
            <p><strong>Port:</strong> {{ web_server_port }}</p>
            <p><strong>Max Connections:</strong> {{ max_connections }}</p>
            <p><strong>Debug Mode:</strong> {{ debug_mode }}</p>
            <p><strong>Log Level:</strong> {{ log_level }}</p>
        </div>

        <div class="card">
            <h3>Performance</h3>
            <p><strong>Worker Processes:</strong> {{ worker_processes }}</p>
            <p><strong>Worker Connections:</strong> {{ worker_connections }}</p>
            <p><strong>Keepalive Timeout:</strong> {{ keepalive_timeout }}s</p>
            <p><strong>Cache Enabled:</strong> {{ cache_enabled }}</p>
        </div>

        <div class="card">
            <h3>Operations</h3>
            <p><strong>Monitoring:</strong> {{ monitoring_enabled }}</p>
            <p><strong>Backup Enabled:</strong> {{ backup_enabled }}</p>
            <p><strong>Security Headers:</strong> {{ security_headers }}</p>
            <p><strong>SSL Enabled:</strong> {{ ssl_enabled }}</p>
        </div>
    </div>

    <div class="success">
        Deployment is idempotent, environment-specific, and managed through Ansible automation.
    </div>
</div>
</body>
</html>
